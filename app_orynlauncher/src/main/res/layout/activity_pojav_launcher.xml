<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oryn_v4_bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- V4 header keeps only the official Oryn logo. -->
    <LinearLayout
        android:id="@+id/oryn_brand"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp"
        android:elevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/oryn_official_logo_v4"
            android:scaleType="centerInside"
            android:contentDescription="Oryn"/>
    </LinearLayout>

    <com.kdt.mcgui.AccountSpinner
        android:tag="oryn_v4"
        android:id="@+id/account_spinner"
        android:layout_width="182dp"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/oryn_account_pill"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:dropDownWidth="wrap_content"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LauncherActivity keeps this view for non-home fragments. -->
    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="82dp"
        android:background="@android:color/transparent"
        android:src="@drawable/oryn_nav_home"
        android:padding="13dp"
        android:visibility="gone"
        android:contentDescription="Home"/>

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>