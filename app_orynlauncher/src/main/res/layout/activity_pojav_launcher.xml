<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oryn_home_bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- V3 reference brand -->
    <LinearLayout
        android:id="@+id/oryn_brand"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="174dp"
        android:layout_marginTop="20dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/oryn_top_logo_o"
            android:contentDescription="Oryn"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Oryn Launcher"
            android:textSize="26sp"
            android:textStyle="normal"
            android:textColor="#3F98FF"/>
    </LinearLayout>

    <!-- Existing account selector, styled to match the reference -->
    <com.kdt.mcgui.AccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="324dp"
        android:layout_height="74dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="62dp"
        android:background="@drawable/oryn_account_pill"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:dropDownWidth="wrap_content"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LauncherActivity keeps this button for non-home fragments. -->
    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="38dp"
        android:layout_marginTop="86dp"
        android:background="@android:color/transparent"
        android:src="@drawable/oryn_nav_home"
        android:padding="13dp"
        android:visibility="gone"
        android:contentDescription="Home"/>

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>