 </LinearLayout>
 <LinearLayout android:layout_width="2dp" android:layout_height="2dp" android:orientation="horizontal" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
