<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oryn_v4_bg">

    <ScrollView
        android:id="@+id/oryn_sidebar"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:background="@drawable/oryn_sidebar"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton android:id="@+id/oryn_home" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/oryn_nav_home" android:background="@drawable/oryn_nav_selected" android:padding="10dp" android:tint="#000000" android:contentDescription="Home" android:layout_marginBottom="7dp"/>
            <ImageButton android:id="@+id/download_button" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/oryn_nav_cube" android:background="@android:color/transparent" android:padding="10dp" android:tint="#FFFFFF" android:contentDescription="@string/oryn_download" android:layout_marginBottom="7dp"/>
            <ImageButton android:id="@+id/custom_control_button" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/oryn_nav_gamepad" android:background="@android:color/transparent" android:padding="10dp" android:tint="#FFFFFF" android:contentDescription="@string/mcl_option_customcontrol" android:layout_marginBottom="7dp"/>
            <ImageButton android:id="@+id/cosmetics_button" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/oryn_nav_cosmetics" android:background="@android:color/transparent" android:padding="10dp" android:tint="#FFFFFF" android:contentDescription="Oryn Cosmetics" android:layout_marginBottom="7dp"/>
            <ImageButton android:id="@+id/oryn_files_nav" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_px_file" android:background="@android:color/transparent" android:padding="10dp" android:tint="#FFFFFF" android:contentDescription="Files" android:layout_marginBottom="7dp"/>
            <ImageButton android:id="@+id/oryn_crash_nav" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/oryn_nav_crash" android:background="@android:color/transparent" android:padding="10dp" android:tint="#FFFFFF" android:contentDescription="Crash Viewer" android:layout_marginBottom="7dp"/>
            <ImageButton android:id="@+id/install_jar_button" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/oryn_nav_settings" android:background="@android:color/transparent" android:padding="10dp" android:tint="#FFFFFF" android:contentDescription="Settings"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="78dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView android:id="@+id/oryn_center_logo" android:layout_width="92dp" android:layout_height="72dp" android:src="@drawable/oryn_official_logo_v4" android:scaleType="fitCenter" android:contentDescription="Oryn Launcher"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Oryn Launcher" android:textSize="28sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:layout_marginTop="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your game, your way.&#10;Simple. Fast. Better." android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="#A8A8A8" android:gravity="center" android:layout_marginTop="5dp"/>

        <Button android:id="@+id/play_button" android:layout_width="230dp" android:layout_height="52dp" android:layout_marginTop="22dp" android:text="▶   Launch" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/oryn_launch_button" android:elevation="3dp"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="230dp"
        android:layout_height="58dp"
        android:background="@drawable/oryn_version_badge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LATEST VERSION" android:textSize="10sp" android:textStyle="bold" android:textColor="#AAAAAA"/>
            <TextView android:id="@+id/oryn_selected_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.12.2" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:tag="oryn_v4" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.01" android:background="@android:color/transparent" android:contentDescription="Select Minecraft instance"/>
    </FrameLayout>

    <ImageView android:id="@+id/oryn_custom_player_image" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Custom profile image"/>
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" android:contentDescription="Edit instance"/>
    <LinearLayout android:id="@+id/oryn_status_card" android:layout_width="220dp" android:layout_height="48dp" android:visibility="gone"/>
    <FrameLayout android:id="@+id/oryn_feature_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/open_files_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Files"/>
    <ImageButton android:id="@+id/crash_viewer_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Crash viewer"/>
    <Button android:id="@+id/social_media_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>