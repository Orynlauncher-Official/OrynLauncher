 <LinearLayout android:id="@+id/oryn_bottom" android:layout_width="230dp" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:layout_marginEnd="26dp" android:layout_marginBottom="20dp" android:background="@drawable/oryn_pill" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
