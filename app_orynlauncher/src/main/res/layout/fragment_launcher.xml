<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D"
    android:padding="10dp">

    <!-- Left navigation rail -->
    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="54dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/oryn_sidebar"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/oryn_home"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_home"
            android:contentDescription="Home"
            android:background="@drawable/oryn_nav_selected"
            android:padding="10dp"
            android:layout_marginBottom="7dp"/>
        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_cube"
            android:contentDescription="@string/oryn_download"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="7dp"/>
        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_gamepad"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="7dp"/>
        <ImageButton
            android:id="@+id/cosmetics_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_cosmetics"
            android:contentDescription="Cosmetics"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="7dp"/>
        <ImageButton
            android:id="@+id/oryn_files_nav"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_px_file"
            android:contentDescription="Files"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="7dp"/>
        <ImageButton
            android:id="@+id/oryn_crash_nav"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_crash"
            android:contentDescription="Crash Viewer"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="7dp"/>
        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_settings"
            android:contentDescription="Settings"
            android:background="@android:color/transparent"
            android:padding="10dp"/>
    </LinearLayout>

    <!-- Clean brand area; keep the existing sidebar and social actions. -->
    <TextView
        android:id="@+id/oryn_plus_title"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="ORYNLAUNCHER\nPLUS"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="14dp"/>

    <LinearLayout
        android:id="@+id/oryn_top_navigation"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/oryn_sidebar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/oryn_plus_title"
        app:layout_constraintStart_toEndOf="@id/oryn_plus_title"
        app:layout_constraintEnd_toStartOf="@id/social_media_button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⌂  Home"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/oryn_nav_selected"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="◇  Instances"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="♧  Cosmetics"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⚙  Settings"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/social_media_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_discord"
        android:contentDescription="Discord"
        android:background="@android:color/transparent"
        android:padding="7dp"
        app:layout_constraintEnd_toStartOf="@id/share_logs_button"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"/>
    <ImageButton
        android:id="@+id/share_logs_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/oryn_external"
        android:contentDescription="Share logs"
        android:background="@android:color/transparent"
        android:padding="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Main content region -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:padding="12dp"
        android:background="@drawable/oryn_home_bg"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toBottomOf="@id/oryn_plus_title"
        app:layout_constraintBottom_toTopOf="@id/oryn_news_about_row">

        <FrameLayout
            android:id="@+id/oryn_custom_player_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#101C2E"
            android:clipToOutline="true"
            app:layout_constraintHeight_percent="0.94"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/oryn_minecraft_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/orynlauncher_snow_hero"
                android:scaleType="centerCrop"
                android:contentDescription="Minecraft landscape preview"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="#CC060B14"
                android:text="WELCOME TO\nOrynLauncher Plus\nPlay. Customize. Explore."
                android:letterSpacing="0.16"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/oryn_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#CC061323"
            app:layout_constraintWidth_percent="0.44"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/oryn_home_skin_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/oryn_account_pill"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:contentDescription="Minecraft account skin"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROFILE"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/oryn_home_account_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Minecraft account"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/oryn_pill"
                    android:text="Ready"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="A quieter world. A brighter adventure."
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Play. Customize. Explore."
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
            <Button
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="▶   PLAY"
                android:textAllCaps="false"
                android:letterSpacing="0.03"
                android:textSize="20sp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#803A8DFF"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:background="@drawable/oryn_launch_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="4dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/oryn_version_badge">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/oryn_nav_cube"
                    android:contentDescription="Minecraft version"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="46dp"
                    android:layout_marginTop="8dp"
                    android:text="GAME VERSION"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/oryn_selected_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="46dp"
                    android:layout_marginTop="26dp"
                    android:text="1.12.2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:tag="oryn_plus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.01"
                    android:background="@android:color/transparent"
                    android:contentDescription="Select Minecraft instance"/>
                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible"
                    android:contentDescription="Edit instance"/>
            </FrameLayout>
        </LinearLayout>
        <View android:id="@+id/oryn_selected_instance_name" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/oryn_instance_version" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/oryn_open_store_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/oryn_play_row" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/oryn_community_row" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right instances panel -->
    <LinearLayout
        android:id="@+id/oryn_feature_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/oryn_home_bg"
        app:layout_constraintWidth_percent="0.27"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oryn_plus_title"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUR WORLDS"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <ImageButton
                android:id="@+id/open_files_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Add instance"
                android:background="@drawable/oryn_pill"
                android:padding="7dp"/>
        </LinearLayout>
        <!-- Populated from Instances.loadDisplay() by MainMenuFragment.
             Keep this container data-driven: never show fabricated example profiles. -->
        <LinearLayout
            android:id="@+id/oryn_instance_name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GAME VERSION"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/oryn_quick_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:background="@drawable/oryn_version_badge"
            android:text="Library   •   Files   •   Settings"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:background="@drawable/oryn_version_badge"
            android:text="Manage profiles and jump back into your world."
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Bottom feature cards: Resource Library and Installation Manager. -->
    <LinearLayout
        android:id="@+id/oryn_news_about_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toBottomOf="@id/oryn_launch_group"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/oryn_news_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/oryn_home_bg">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/oryn_official_logo_v4"
                    android:scaleType="fitCenter"
                    android:contentDescription="Resource Library"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CUSTOM MODPACKS"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Explore curated modpacks and play your way."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:background="@drawable/oryn_pill"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/oryn_about_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/oryn_home_bg">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/oryn_nav_cube"
                    android:scaleType="fitCenter"
                    android:contentDescription="Installation Manager"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NEW FEATURES"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Discover a smoother, faster launcher."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:background="@drawable/oryn_pill"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Retain the legacy status view for Java compatibility, but keep it off-screen. -->
    <LinearLayout
        android:id="@+id/oryn_status_card"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/crash_viewer_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Crash viewer"/>
</androidx.constraintlayout.widget.ConstraintLayout>