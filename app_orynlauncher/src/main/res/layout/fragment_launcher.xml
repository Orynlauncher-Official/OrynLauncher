<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oryn_home_bg">

    <!-- V3 reference: compact top action dock -->
    <LinearLayout
        android:id="@+id/oryn_feature_panel"
        android:layout_width="524dp"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:background="@drawable/oryn_pill"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp">

        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="82dp"
            android:layout_height="56dp"
            android:src="@drawable/oryn_nav_download"
            android:contentDescription="@string/oryn_download"
            android:background="@android:color/transparent"
            android:padding="14dp"/>

        <ImageButton
            android:id="@+id/crash_viewer_button"
            android:layout_width="82dp"
            android:layout_height="56dp"
            android:src="@drawable/oryn_top_document"
            android:contentDescription="@string/oryn_crash_viewer"
            android:background="@android:color/transparent"
            android:padding="14dp"/>

        <ImageButton
            android:id="@+id/cosmetics_quick_button"
            android:layout_width="82dp"
            android:layout_height="56dp"
            android:src="@drawable/oryn_top_star"
            android:contentDescription="Oryn Cosmetics"
            android:background="@android:color/transparent"
            android:padding="14dp"/>
    </LinearLayout>

    <!-- V3 reference left navigation -->
    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="102dp"
        android:layout_height="444dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="34dp"
        android:paddingBottom="24dp"
        android:background="@drawable/oryn_sidebar"
        android:layout_marginStart="38dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/oryn_home"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/oryn_nav_home"
            android:contentDescription="Home"
            android:background="@drawable/oryn_nav_selected"
            android:padding="17dp"/>

        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/oryn_nav_gamepad"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:background="@android:color/transparent"
            android:padding="18dp"/>

        <ImageButton
            android:id="@+id/open_files_button"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/oryn_nav_folder"
            android:contentDescription="@string/mcl_button_open_directory"
            android:background="@android:color/transparent"
            android:padding="18dp"/>

        <ImageButton
            android:id="@+id/cosmetics_button"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:src="@drawable/oryn_nav_cosmetics"
            android:contentDescription="Oryn Cosmetics"/>

        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/oryn_nav_settings"
            android:contentDescription="Settings"
            android:background="@android:color/transparent"
            android:padding="18dp"/>
    </LinearLayout>

    <!-- Center: the reference uses a clean, oversized Launch button -->
    <LinearLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/play_button"
            android:layout_width="414dp"
            android:layout_height="118dp"
            android:text="▶   |   Launch"
            android:textAllCaps="false"
            android:textSize="27sp"
            android:textStyle="normal"
            android:textColor="#FFFFFF"
            android:background="@drawable/oryn_launch_button"
            android:elevation="5dp"/>
    </LinearLayout>

    <!-- Keep the existing instance selector functional but visually out of the V3 reference. -->
    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        android:text="Select Instance"/>

    <!-- Existing customization compatibility target. -->
    <ImageView
        android:id="@+id/oryn_custom_player_image"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Custom profile image"/>

    <Button
        android:id="@+id/edit_profile_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        android:contentDescription="Edit instance"/>

    <LinearLayout
        android:id="@+id/oryn_status_card"
        android:layout_width="374dp"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:background="@drawable/oryn_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="28dp">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="34dp"
            android:background="@drawable/oryn_status_icon"/>

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_official_logo_v4"
            android:scaleType="centerInside"
            android:contentDescription="Oryn"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="1.12.2"
            android:textSize="17sp"
            android:textColor="#4B9FFF"/>

        <ImageButton
            android:id="@+id/share_logs_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/oryn_external"
            android:contentDescription="Open"
            android:background="@android:color/transparent"
            android:padding="10dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/social_media_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>