 </LinearLayout>
 <LinearLayout android:id="@+id/oryn_launch_group" android:layout_width="260dp" android:layout_height="76dp" android:gravity="center" android:background="@drawable/oryn_pill" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
