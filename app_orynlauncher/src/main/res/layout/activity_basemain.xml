<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<net.kdt.pojavlaunch.game.GameView
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
                tools:ignore="UnusedAttribute">

				<net.kdt.pojavlaunch.game.GameCursorView
					android:layout_height="match_parent"
					android:layout_width="match_parent"
					android:orientation="vertical"
					android:id="@+id/main_cursorview"
					android:focusable="false"
					android:translationZ="1dp"
					android:visibility="gone"
					app:defaultCursorDrawable="@drawable/ic_mouse_pointer"/>

			</net.kdt.pojavlaunch.game.GameView>


			<net.kdt.pojavlaunch.customcontrols.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<net.kdt.pojavlaunch.customcontrols.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</net.kdt.pojavlaunch.customcontrols.ControlLayout>

		<FrameLayout
			android:id="@+id/main_loading_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#BB000000"
			android:visibility="visible"
			>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="24dp">

				<ImageView
					android:layout_width="112dp"
					android:layout_height="112dp"
					android:layout_marginBottom="18dp"
					android:src="@drawable/oryn_official_logo_v4"
					android:scaleType="fitCenter"
					android:contentDescription="OrynLauncher logo" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="6dp"
					android:text="ORYN LAUNCHER"
					android:textColor="#FFFFFF"
					android:textStyle="bold"
					android:letterSpacing="0.12"
					android:textSize="21sp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="22dp"
					android:text="PLUS"
					android:textColor="#FFFFFF"
					android:textStyle="bold"
					android:letterSpacing="0.35"
					android:textSize="12sp" />

				<ProgressBar
					android:id="@+id/main_loading_screen_progress"
					android:layout_width="42dp"
					android:layout_height="4dp"
					android:indeterminate="true"
					android:indeterminateTint="#8BE8FF"
					android:layout_marginBottom="12dp" />

				<TextView
					android:id="@+id/main_loading_screen_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/loading_screen_title"
					android:textColor="#FFFFFF"
					android:textSize="16sp" />

				<TextView
					android:id="@+id/main_loading_screen_warning"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="@string/loading_screen_warning"
					android:textColor="#B8C8D8"
					android:textSize="12sp" />
			</LinearLayout>
		</FrameLayout>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

	<ListView
		android:layout_width="280dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="@drawable/background_game_menu_drawer"
		android:divider="@null"
		android:dividerHeight="0dp"
		android:fitsSystemWindows="false"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

