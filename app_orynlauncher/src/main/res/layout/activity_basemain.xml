<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<net.kdt.pojavlaunch.game.GameView
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
                tools:ignore="UnusedAttribute">

				<net.kdt.pojavlaunch.game.GameCursorView
					android:layout_height="match_parent"
					android:layout_width="match_parent"
					android:orientation="vertical"
					android:id="@+id/main_cursorview"
					android:focusable="false"
					android:translationZ="1dp"
					android:visibility="gone"
					app:defaultCursorDrawable="@drawable/ic_mouse_pointer"/>

			</net.kdt.pojavlaunch.game.GameView>


			<net.kdt.pojavlaunch.customcontrols.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<net.kdt.pojavlaunch.customcontrols.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</net.kdt.pojavlaunch.customcontrols.ControlLayout>

		<FrameLayout
			android:id="@+id/main_loading_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#FF050505"
			android:visibility="visible">

			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:src="@drawable/oryn_settings_background"
				android:scaleType="centerCrop"
				android:alpha="0.48"
				android:contentDescription="@null" />

			<View
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#99000000" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:paddingStart="28dp"
				android:paddingEnd="28dp"
				android:paddingTop="20dp"
				android:paddingBottom="18dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<View
						android:layout_width="2dp"
						android:layout_height="36dp"
						android:background="#FFFFFFFF"
						android:layout_marginEnd="14dp" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="ORYN LAUNCHER PLUS"
							android:textColor="#FFFFFFFF"
							android:textSize="13sp"
							android:letterSpacing="0.22"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="PLAY  •  EXPLORE  •  CREATE"
							android:textColor="#D8D8D8"
							android:textSize="9sp"
							android:letterSpacing="0.24" />
					</LinearLayout>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="v5.0   |   ✦  Better. Faster. Oryn."
						android:textColor="#EAEAEA"
						android:textSize="10sp" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="vertical"
					android:padding="12dp">

					<ImageView
						android:id="@+id/oryn_loading_logo"
						android:layout_width="104dp"
						android:layout_height="104dp"
						android:layout_marginBottom="12dp"
						android:src="@drawable/oryn_official_logo_v4"
						android:scaleType="fitCenter"
						android:contentDescription="OrynLauncher logo" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="ORYN"
						android:textColor="#FFFFFFFF"
						android:textStyle="bold"
						android:letterSpacing="0.32"
						android:textSize="30sp" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="L A U N C H E R   •   P L U S"
						android:textColor="#F0F0F0"
						android:textSize="10sp"
						android:letterSpacing="0.16" />

					<TextView
						android:id="@+id/main_loading_screen_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="36dp"
						android:layout_marginBottom="14dp"
						android:text="Loading your adventure..."
						android:textColor="#FFFFFFFF"
						android:textSize="15sp" />

					<ProgressBar
						android:id="@+id/main_loading_screen_progress"
						style="?android:attr/progressBarStyleHorizontal"
						android:layout_width="min(340dp, 72%)"
						android:layout_height="5dp"
						android:indeterminate="true"
						android:indeterminateTint="#FFFFFFFF"
						android:progressTint="#FFFFFFFF"
						android:progressBackgroundTint="#55FFFFFF" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:text="PREPARING YOUR WORLD"
						android:textColor="#D6D6D6"
						android:textSize="9sp"
						android:letterSpacing="0.2" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingTop="10dp">

					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="⬡\nMINECRAFT\nLAUNCH" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="♙\nACCOUNTS" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="↓\nDOWNLOADS" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="⚙\nSETTINGS" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="▱\nORYNFILES" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="♧\nMODS &amp;\nMODPACKS" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
					<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="☷\nCONTROLS" android:textColor="#FFFFFFFF" android:textSize="9sp" android:letterSpacing="0.04" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="OrynLauncher Plus  •  © 2026"
						android:textColor="#BEBEBE"
						android:textSize="9sp" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="MORE THAN A LAUNCHER"
						android:textColor="#FFFFFFFF"
						android:textSize="9sp"
						android:letterSpacing="0.18" />
				</LinearLayout>
			</LinearLayout>
		</FrameLayout>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

	<ListView
		android:layout_width="280dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="@drawable/background_game_menu_drawer"
		android:divider="@null"
		android:dividerHeight="0dp"
		android:fitsSystemWindows="false"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

