<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080817">

    <ImageView
        android:id="@+id/oryn_add_account_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/oryn_auth_panel"
        android:elevation="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add account"
            android:textColor="#E8E2FF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:paddingBottom="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#8C70F5"
            android:layout_marginBottom="18dp" />

        <Button
            style="@style/Widget.AppCompat.Button.Borderless"
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/oryn_auth_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:drawableStart="@null"
            android:drawableEnd="@null"
            android:drawableTop="@null"
            android:drawableBottom="@null"
            android:drawablePadding="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:shadowColor="#00000000"
            android:text="@string/auth_select_microsoft"
            android:textColor="#E8E2FF"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            style="@style/Widget.AppCompat.Button.Borderless"
            android:id="@+id/button_elyby_authentication"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/oryn_auth_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:drawableStart="@null"
            android:drawableEnd="@null"
            android:drawableTop="@null"
            android:drawableBottom="@null"
            android:drawablePadding="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:shadowColor="#00000000"
            android:text="@string/auth_select_elyby"
            android:textColor="#E8E2FF"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            style="@style/Widget.AppCompat.Button.Borderless"
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/oryn_auth_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:drawableStart="@null"
            android:drawableEnd="@null"
            android:drawableTop="@null"
            android:drawableBottom="@null"
            android:drawablePadding="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:shadowColor="#00000000"
            android:text="@string/auth_select_local"
            android:textColor="#E8E2FF"
            android:textAllCaps="false"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
