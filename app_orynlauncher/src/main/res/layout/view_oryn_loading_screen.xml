<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/oryn_loading_screen"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="#F2111112"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_extra_extra_large"
        android:paddingEnd="@dimen/padding_extra_extra_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="◯   Oryn Launcher"
            android:textColor="#F4F4F5"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/padding_extra_large"
            android:indeterminate="true"
            android:indeterminateTint="#F4F4F5" />

        <TextView
            android:id="@+id/oryn_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_large"
            android:gravity="center"
            android:text="@string/oryn_loading_title"
            android:textColor="#F4F4F5"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/oryn_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:gravity="center"
            android:text="@string/oryn_loading_please_wait"
            android:textColor="#A1A1AA"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>
</FrameLayout>
