<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#263A4F" />
            <stroke android:width="1dp" android:color="#558BC4" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#121A24" />
            <stroke android:width="1dp" android:color="#26384C" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
