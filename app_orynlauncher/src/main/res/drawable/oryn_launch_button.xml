<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#269BFF" android:centerColor="#147FF0" android:endColor="#0758C9" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#579FFF" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#36A8FF" android:centerColor="#1688F8" android:endColor="#0B6CE0" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#397FE8" />
        </shape>
    </item>
</layer-list>
