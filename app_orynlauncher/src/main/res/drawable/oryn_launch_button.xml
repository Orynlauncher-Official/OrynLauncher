<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bright icy outer rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4FDFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Cold blue glow -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#E8FCFF" android:centerColor="#75D8FF" android:endColor="#E5FAFF" android:angle="0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Snowy glass face -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#DFFAFF" android:centerColor="#249DFA" android:endColor="#0878D8" android:angle="270" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#D9F8FF" />
        </shape>
    </item>
</layer-list>
