<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:key=""
    >

    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>

    <Preference
        android:key="theme_color"
        android:title="Theme Color"
        android:summary="Choose a launcher accent color — changes apply instantly"
        android:icon="@drawable/ic_px_sliders"/>

    <PreferenceCategory
        android:title="OrynLauncher V3"
        android:key="oryn_v3_category">

        <Preference
            android:key="oryn_customization"
            android:title="Oryn Customization"
            android:summary="Themes, backgrounds, colors, buttons, animations and home personalization"
            android:icon="@drawable/ic_px_sliders"/>

        <Preference
            android:key="oryn_cosmetics"
            android:title="Oryn Cosmetics"
            android:summary="Manage your existing Skin and Cape"
            android:icon="@drawable/ic_px_image"/>

        <SwitchPreference
            android:key="orynFpsBoost"
            android:title="Oryn FPS Boost"
            android:summary="Real in-game optimization for lower rendering workload"
            android:icon="@drawable/ic_px_sliders"/>

        <Preference
            android:key="oryn_crash_viewer"
            android:title="Oryn Crash Viewer"
            android:summary="View and inspect Minecraft crash logs"
            android:icon="@drawable/oryn_nav_crash"/>

        <Preference
            android:key="oryn_files"
            android:title="Oryn Files"
            android:summary="Browse and manage launcher files"
            android:icon="@drawable/ic_px_file"/>

        <Preference
            android:key="oryn_downloads"
            android:title="Oryn Downloads"
            android:summary="Mods, resource packs and shaders"
            android:icon="@drawable/ic_px_file_dl"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/preference_category_main_categories"
        >

        <Preference
            android:key="recorder_screen_setting"
            android:title="OrynLauncher Recorder"
            android:summary="OrynLauncher video quality, FPS and saved recordings"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceRecorderFragment"
            android:icon="@drawable/ic_px_image"
            />

        <Preference
            android:key="video_screen_setting"
            android:title="@string/preference_video_title"
            android:summary="@string/preference_video_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceVideoFragment"
            android:icon="@drawable/ic_px_image"
            />

        <Preference
            android:key="control_screen_setting"
            android:title="@string/preference_control_title"
            android:summary="@string/preference_control_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceControlFragment"
            android:icon="@drawable/ic_px_gamepad"
            />

        <Preference
            android:key="java_screen_setting"
            android:title="@string/preference_java_title"
            android:summary="@string/preference_java_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceJavaFragment"
            android:icon="@drawable/ic_px_java"
            />

        <Preference
            android:key="misc_screen_setting"
            android:title="@string/preference_misc_title"
            android:summary="@string/preference_misc_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceMiscellaneousFragment"
            android:icon="@drawable/ic_px_sliders"
            />


        <Preference
            android:key="experimental_screen_setting"
            android:title="@string/preference_experimental_title"
            android:summary="@string/preference_experimental_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceExperimentalFragment"
            android:icon="@drawable/ic_px_experiment"/>
    </PreferenceCategory>

    <SwitchPreference
        android:title="@string/preference_force_english_title"
        android:key="force_english"
        android:summary="@string/preference_force_english_description"
        android:icon="@drawable/ic_px_translate"/>

    <Preference
        android:title="@string/preference_ask_for_notification_title"
        android:summary="@string/preference_ask_for_notification_description"
        android:key="notification_permission_request"
        android:icon="@drawable/ic_px_bell"
        />





</PreferenceScreen>