<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/oryn_home_bg">
<androidx.fragment.app.FragmentContainerView android:id="@+id/container_fragment" android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<LinearLayout android:id="@+id/oryn_brand" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="62dp" android:layout_marginTop="3dp" android:orientation="horizontal" android:gravity="center_vertical" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
<ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_v4_crystal" android:contentDescription="Oryn Launcher Plus logo"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Oryn Launcher " android:textColor="#EAF1FC" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plus" android:textColor="#168FFF" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
<LinearLayout android:id="@+id/oryn_social_links" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center" android:layout_marginEnd="12dp" app:layout_constraintEnd_toStartOf="@id/oryn_account_header" app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="5dp">
<ImageButton android:id="@+id/oryn_discord_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_discord" android:contentDescription="Open OrynLauncher Discord" android:background="@android:color/transparent" android:padding="8dp"/>
<ImageButton android:id="@+id/oryn_youtube_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_youtube" android:contentDescription="Open OrynLauncher YouTube" android:background="@android:color/transparent" android:padding="7dp"/>
<ImageButton android:id="@+id/oryn_website_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_globe" android:contentDescription="Open OrynLauncher website" android:background="@android:color/transparent" android:padding="8dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/oryn_account_header" android:layout_width="104dp" android:layout_height="48dp" android:layout_marginEnd="10dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:background="@android:color/transparent" android:paddingHorizontal="2dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
<ImageView android:id="@+id/oryn_account_avatar_image" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_oryn_user" android:background="@drawable/oryn_account_pill" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="Account skin head"/>
<com.kdt.mcgui.AccountSpinner android:id="@+id/account_spinner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:alpha="0.02" android:singleLine="true" android:ellipsize="end" android:background="@android:color/transparent" android:dropDownWidth="wrap_content"/>
<TextView android:layout_width="20dp" android:layout_height="match_parent" android:gravity="center" android:text="⌄" android:textColor="#C8D8F4" android:textSize="20sp"/>
</LinearLayout>
<ImageButton android:id="@+id/setting_button" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="37dp" android:layout_marginTop="24dp" android:visibility="gone" android:src="@drawable/oryn_nav_settings" android:contentDescription="Settings" android:background="@android:color/transparent" android:padding="12dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<com.kdt.mcgui.ProgressLayout android:id="@+id/progress_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>