<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030914"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="54dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/oryn_sidebar"
        android:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton android:id="@+id/oryn_home" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_home" android:contentDescription="Home" android:background="@drawable/oryn_nav_selected" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/download_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_cube" android:contentDescription="@string/oryn_download" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/custom_control_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_gamepad" android:contentDescription="@string/mcl_option_customcontrol" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/cosmetics_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_cosmetics" android:contentDescription="Recorder and cosmetics" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/oryn_files_nav" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_px_file" android:contentDescription="Files" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/oryn_crash_nav" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_crash" android:contentDescription="Crash viewer" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/install_jar_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_settings" android:contentDescription="Settings" android:background="@android:color/transparent" android:padding="8dp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:padding="8dp"
        android:background="@drawable/oryn_home_bg"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/oryn_news_about_row">

        <FrameLayout
            android:id="@+id/oryn_custom_player_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/oryn_preview_frame"
            android:clipToOutline="true"
            app:layout_constraintWidth_percent="0.52"
            app:layout_constraintHeight_percent="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/oryn_minecraft_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/oryn_minecraft_preview"
                android:scaleType="centerCrop"
                android:contentDescription="Minecraft landscape preview"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:padding="8dp"
                android:background="#CC060B14"
                android:id="@+id/oryn_selected_instance_name"
                android:text="Selected instance"
                android:textColor="#F4F7FC"
                android:textStyle="bold"
                android:textSize="11sp"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/oryn_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:paddingEnd="4dp"
            app:layout_constraintStart_toEndOf="@id/oryn_custom_player_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ORYNLAUNCHER PLUS" android:textColor="#F4F7FC" android:textSize="17sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/oryn_pill" android:text="Ready" android:textColor="#5CB3FF" android:textSize="10sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="A quieter world. A brighter adventure." android:textColor="#B8C9E2" android:textSize="11sp"/>
            <Button
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="▶    PLAY"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/oryn_launch_button"
                android:elevation="2dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/oryn_version_badge">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="8dp" android:src="@drawable/oryn_nav_cube" android:contentDescription="Minecraft version"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="36dp" android:layout_marginTop="6dp" android:text="GAME VERSION" android:textColor="#B9C7DB" android:textSize="10sp"/>
                <TextView android:id="@+id/oryn_selected_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="36dp" android:layout_marginTop="23dp" android:text="Choose a version" android:textColor="#FFFFFF" android:textSize="11sp"/>
                <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:tag="oryn_plus" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.01" android:background="@android:color/transparent" android:contentDescription="Select Minecraft version"/>
                <ImageButton android:id="@+id/edit_profile_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" android:contentDescription="Edit selected profile"/>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="PLAY YOUR OWN STORY  •  WINTER WORLDS" android:textColor="#91A9C8" android:textSize="9sp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/oryn_feature_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/oryn_home_bg"
        app:layout_constraintWidth_percent="0.285"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="70dp"
        android:layout_marginStart="3dp"
        android:layout_marginBottom="5dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Your worlds" android:textColor="#EAF1FC" android:textSize="13sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/open_files_button" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_add" android:contentDescription="Add or manage instances" android:background="@drawable/oryn_pill" android:padding="6dp"/>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:fillViewport="false"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR WORLDS"
                    android:textColor="#8194B0"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/oryn_instance_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="GAME VERSION"
                    android:textColor="#8194B0"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/oryn_instance_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="9dp"
                    android:background="@drawable/oryn_account_pill"
                    android:text="Select from the version card"
                    android:textColor="#C6D2E5"
                    android:textSize="10sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="QUICK ACCESS"
                    android:textColor="#8194B0"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="9dp"
                    android:background="@drawable/oryn_account_pill"
                    android:text="Library  •  Files  •  Settings"
                    android:textColor="#C6D2E5"
                    android:textSize="10sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ORYNLAUNCHER PLUS"
                    android:textColor="#8194B0"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="9dp"
                    android:background="@drawable/oryn_account_pill"
                    android:text="Manage profiles and jump back into your world."
                    android:textColor="#C6D2E5"
                    android:textSize="10sp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <!-- Compact News and About cards are present in landscape too. -->
    <LinearLayout
        android:id="@+id/oryn_news_about_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="6dp"
        app:layout_constraintHeight_percent="0.27"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toBottomOf="@id/oryn_launch_group"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/oryn_news_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/oryn_home_bg">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="News  •  Oryn Launcher Plus"
                android:textColor="#EAF1FC"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="New features, performance improvements and community updates."
                android:textColor="#9BAEC9"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/oryn_about_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/oryn_home_bg">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="#EAF1FC"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Oryn Launcher Plus  •  Simple. Fast. Powerful."
                android:textColor="#9BAEC9"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <ImageButton android:id="@+id/crash_viewer_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Crash viewer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
