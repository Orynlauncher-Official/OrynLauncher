<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A18"
    android:padding="8dp">

    <!-- Header: logo and navigation, styled after the supplied Oryn Plus reference. -->
    <LinearLayout
        android:id="@+id/oryn_top_bar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_v4_crystal"
            android:scaleType="fitCenter"
            android:contentDescription="Oryn Launcher logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/oryn_plus_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORYN LAUNCHER"
                    android:textColor="#F7F9FF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:letterSpacing="0.02" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/oryn_launch_button"
                    android:text="PLUS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play  •  Mod  •  Explore  •  Together"
                android:textColor="#A9B7D3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact center navigation. Existing sidebar controls remain fully functional. -->
    <LinearLayout
        android:id="@+id/oryn_top_navigation"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/oryn_sidebar"
        app:layout_constraintTop_toTopOf="@id/oryn_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/oryn_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/oryn_nav_selected"
            android:text="⌂  Home"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="◇  Instances"
            android:textColor="#E7EDFA"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="✿  Mods"
            android:textColor="#E7EDFA"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⚙  Settings"
            android:textColor="#E7EDFA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Left icon rail. -->
    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="54dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:background="@drawable/oryn_sidebar"
        android:elevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oryn_top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/oryn_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/oryn_nav_home"
            android:contentDescription="Home"
            android:background="@drawable/oryn_nav_selected"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/oryn_nav_cube"
            android:contentDescription="@string/oryn_download"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/oryn_nav_gamepad"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/cosmetics_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/oryn_nav_cosmetics"
            android:contentDescription="Cosmetics"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/oryn_files_nav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_px_file"
            android:contentDescription="Files"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/oryn_crash_nav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/oryn_nav_crash"
            android:contentDescription="Crash viewer"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/oryn_nav_settings"
            android:contentDescription="Settings"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|center"
            android:paddingBottom="8dp"
            android:text="v4.0.0+"
            android:textColor="#7E8CA8"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- Wide Minecraft hero. The original version selector and launch action are preserved. -->
    <FrameLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/oryn_home_bg"
        android:clipToOutline="true"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oryn_top_bar"
        app:layout_constraintBottom_toTopOf="@id/oryn_news_about_row"
        app:layout_constraintHeight_percent="0.39">

        <FrameLayout
            android:id="@+id/oryn_custom_player_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/oryn_home_bg"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/oryn_minecraft_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/orynlauncher_snow_hero"
                android:scaleType="centerCrop"
                android:contentDescription="Minecraft landscape preview" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#3A071126" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/oryn_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟩  Minecraft Java Edition"
                android:textColor="#E3EAFB"
                android:textSize="12sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="ORYN LAUNCHER PLUS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="26sp"
                android:letterSpacing="0.02"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Better Performance  •  More Freedom  •  Your World"
                android:textColor="#E1E8F8"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button
                    android:id="@+id/play_button"
                    android:layout_width="220dp"
                    android:layout_height="56dp"
                    android:text="▶  LAUNCH"
                    android:textAllCaps="false"
                    android:letterSpacing="0.02"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/oryn_launch_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@animator/oryn_motion_bounce"
                    android:elevation="3dp" />
                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/oryn_nav_settings"
                    android:contentDescription="Launch options"
                    android:background="@drawable/oryn_account_pill"
                    android:padding="13dp"
                    android:stateListAnimator="@animator/oryn_motion_bounce" />
            </LinearLayout>
            <TextView
                android:id="@+id/oryn_selected_instance_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Minecraft"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/oryn_home_skin_avatar"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:contentDescription="Current account skin"
                android:visibility="gone" />
            <TextView
                android:id="@+id/oryn_home_account_name"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:text="Minecraft account"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Version badge at lower right; the transparent spinner remains interactive. -->
        <FrameLayout
            android:layout_width="190dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/oryn_account_pill">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="10dp"
                android:src="@drawable/oryn_nav_cube"
                android:contentDescription="Minecraft version" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="7dp"
                android:text="Latest Version"
                android:textColor="#AEBBD4"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/oryn_selected_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="24dp"
                android:text="No version installed"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:tag="oryn_plus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.02"
                android:background="@android:color/transparent"
                android:contentDescription="Select Minecraft version" />
        </FrameLayout>
    </FrameLayout>

    <!-- Latest news cards. They are real clickable entry points to the existing download center. -->
    <LinearLayout
        android:id="@+id/oryn_news_about_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/oryn_home_bg"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toBottomOf="@id/oryn_launch_group"
        app:layout_constraintBottom_toTopOf="@id/oryn_play_row">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_px_file"
                android:contentDescription="Latest news" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="LATEST NEWS"
                android:textColor="#F7F9FF"
                android:textStyle="bold"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View All  →"
                android:textColor="#C5D2EB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/oryn_news_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="5dp"
                android:background="@drawable/oryn_account_pill">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/oryn_minecraft_preview"
                    android:scaleType="centerCrop"
                    android:contentDescription="Minecraft update artwork" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="THE WILD UPDATE RETURNS!"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="New biomes, new mobs and more to explore."
                    android:textColor="#AEBBD4"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/oryn_about_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:padding="5dp"
                android:background="@drawable/oryn_account_pill">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/orynlauncher_snow_hero"
                    android:scaleType="centerCrop"
                    android:contentDescription="Minecraft community artwork" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="BETTER TOGETHER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="More freedom for your next adventure."
                    android:textColor="#AEBBD4"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Friends panel styled like the supplied mockup; the launcher does not fabricate online status. -->
    <LinearLayout
        android:id="@+id/oryn_feature_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/oryn_home_bg"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintWidth_percent="0.29"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oryn_launch_group"
        app:layout_constraintBottom_toTopOf="@id/oryn_play_row">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/oryn_nav_cosmetics"
                android:contentDescription="Community" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="FRIENDS"
                android:textColor="#F7F9FF"
                android:textStyle="bold"
                android:textSize="15sp" />
            <ImageButton
                android:id="@+id/open_files_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Manage instances"
                android:background="@drawable/oryn_account_pill"
                android:padding="7dp"
                android:stateListAnimator="@animator/oryn_motion_bounce" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_oryn_user" android:background="@drawable/oryn_account_pill" android:padding="4dp" android:contentDescription="Player avatar" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Community" android:textColor="#F4F7FF" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Join other Oryn players" android:textColor="#AAB8D2" android:textSize="9sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#B9C9E7" android:textSize="24sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22314C" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_cube" android:background="@drawable/oryn_account_pill" android:padding="6dp" android:contentDescription="Instances" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your instances" android:textColor="#F4F7FF" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage saved game profiles" android:textColor="#AAB8D2" android:textSize="9sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#B9C9E7" android:textSize="24sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22314C" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_cosmetics" android:background="@drawable/oryn_account_pill" android:padding="6dp" android:contentDescription="Cosmetics" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cosmetics" android:textColor="#F4F7FF" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Skins and appearance" android:textColor="#AAB8D2" android:textSize="9sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#B9C9E7" android:textSize="24sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22314C" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_discord" android:background="@drawable/oryn_account_pill" android:padding="6dp" android:contentDescription="Discord community" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Oryn Community" android:textColor="#F4F7FF" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Support, updates and more" android:textColor="#AAB8D2" android:textSize="9sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#B9C9E7" android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom strip mirrors the reference's Explore More and community call-to-action. -->
    <LinearLayout
        android:id="@+id/oryn_play_row"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/oryn_home_bg"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/oryn_nav_cube"
            android:background="@drawable/oryn_account_pill"
            android:padding="9dp"
            android:contentDescription="Explore" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore More"
                android:textColor="#F7F9FF"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Mods  •  Clients  •  Skins  •  And More"
                android:textColor="#AAB8D2"
                android:textSize="10sp" />
        </LinearLayout>
        <Button
            android:id="@+id/oryn_open_store_button"
            android:layout_width="140dp"
            android:layout_height="42dp"
            android:text="OPEN STORE  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/oryn_launch_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
    </LinearLayout>

    <!-- Existing instance list/version label retained for the Java backend and updated from real data. -->
    <LinearLayout
        android:id="@+id/oryn_instance_name"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="vertical"
        android:visibility="gone" />
    <TextView
        android:id="@+id/oryn_instance_version"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:text="No version installed"
        android:visibility="gone" />
    <ImageButton
        android:id="@+id/crash_viewer_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Crash viewer" />

</androidx.constraintlayout.widget.ConstraintLayout>