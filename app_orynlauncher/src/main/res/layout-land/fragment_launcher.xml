<?xml version="1.0" encoding="utf-8"?>
<!-- OrynLauncher V4 reference interface -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oryn_v4_bg">

    <!-- Reference left navigation: fixed near the upper-left, not vertically centered. -->
    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="90dp"
        android:layout_height="482dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:background="@drawable/oryn_sidebar"
        android:layout_marginStart="0dp"
        android:layout_marginTop="94dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/oryn_home"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/oryn_nav_home"
            android:contentDescription="Home"
            android:background="@drawable/oryn_nav_selected"
            android:padding="15dp"
            android:layout_marginBottom="8dp"/>

        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/oryn_nav_cube"
            android:contentDescription="@string/oryn_download"
            android:background="@android:color/transparent"
            android:padding="15dp"
            android:layout_marginBottom="8dp"/>

        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/oryn_nav_gamepad"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:background="@android:color/transparent"
            android:padding="15dp"
            android:layout_marginBottom="8dp"/>

        <ImageButton
            android:id="@+id/cosmetics_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/oryn_nav_cosmetics"
            android:contentDescription="Oryn Cosmetics"
            android:background="@android:color/transparent"
            android:padding="15dp"
            android:layout_marginBottom="8dp"/>

        <ImageButton
            android:id="@+id/oryn_cape_nav"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/oryn_cape_nav"
            android:contentDescription="Cape"
            android:background="@android:color/transparent"
            android:padding="15dp"
            android:clickable="false"
            android:focusable="false"
            android:layout_marginBottom="8dp"/>

        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/oryn_nav_settings"
            android:contentDescription="Settings"
            android:background="@android:color/transparent"
            android:padding="15dp"/>
    </LinearLayout>

    <!-- Reference center hero -->
    <LinearLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="510dp"
        android:layout_height="300dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="185dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/oryn_center_logo"
            android:layout_width="150dp"
            android:layout_height="110dp"
            android:src="@drawable/oryn_official_logo_v4"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Oryn Launcher"/>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="38dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oryn "
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#F2F5FA"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Launcher"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#168FFF"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your game, your way.&#10;Simple. Fast. Better."
                android:textSize="18sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#94A9C9"/>

            <Button
                android:id="@+id/play_button"
                android:layout_width="265dp"
                android:layout_height="60dp"
                android:layout_marginTop="25dp"
                android:text="▶   Launch    ›"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/oryn_launch_button"
                android:elevation="4dp"/>

            <FrameLayout
                android:layout_width="265dp"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/oryn_version_badge">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/oryn_nav_cube"
                    android:contentDescription="Latest Version"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="13dp"
                    android:text="Latest Version"
                    android:textSize="13sp"
                    android:textColor="#E6EDF8"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="35dp"
                    android:text="1.20.4"
                    android:textSize="12sp"
                    android:textColor="#8198BA"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center"
                    android:paddingEnd="18dp"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#A8BAD6"/>

                <com.kdt.mcgui.mcVersionSpinner
                    android:tag="oryn_v4"
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.01"
                    android:background="@android:color/transparent"
                    android:contentDescription="Select Minecraft instance"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/oryn_custom_player_image"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Custom profile image"/>

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        android:contentDescription="Edit instance"/>

    <!-- Bottom-right quick status from the reference -->
    <LinearLayout
        android:id="@+id/oryn_status_card"
        android:layout_width="250dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@drawable/oryn_account_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="48dp">

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/oryn_status_dot"/>

        <ImageView
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:src="@drawable/oryn_official_logo_v4"
            android:contentDescription="Oryn"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:text="Oryn"
            android:textSize="13sp"
            android:textColor="#EAF1FB"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="1.12.2"
            android:textSize="13sp"
            android:textColor="#6096CF"/>

        <ImageButton
            android:id="@+id/share_logs_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/oryn_external"
            android:contentDescription="Open"
            android:background="@android:color/transparent"
            android:padding="5dp"/>
    </LinearLayout>

    <!-- Compatibility hook for OrynCustomizationManager. -->
    <FrameLayout
        android:id="@+id/oryn_feature_panel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Existing wiring kept alive but visually hidden. -->
    <ImageButton
        android:id="@+id/open_files_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Files"/>

    <ImageButton
        android:id="@+id/crash_viewer_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Crash viewer"/>

    <Button
        android:id="@+id/social_media_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>