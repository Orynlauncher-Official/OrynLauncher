<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D">

    <!-- ============ LEFT SIDEBAR: logo + labelled navigation ============ -->
    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/oryn_sidebar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="8dp"
            android:background="@drawable/oryn_account_pill"
            android:src="@drawable/oryn_v4_crystal"
            android:scaleType="fitCenter"
            android:contentDescription="OrynLauncher logo" />

        <!-- Home -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/oryn_nav_selected">
            <ImageButton
                android:id="@+id/oryn_home"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oryn_nav_home"
                android:contentDescription="Home"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:stateListAnimator="@animator/oryn_motion_bounce" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Instances -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/open_files_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oryn_nav_cube"
                android:contentDescription="Instances"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:stateListAnimator="@animator/oryn_motion_bounce" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instances"
                android:textColor="#B9C3DA"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Cosmetics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/cosmetics_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oryn_nav_cosmetics"
                android:contentDescription="Cosmetics"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:stateListAnimator="@animator/oryn_motion_bounce" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cosmetics"
                android:textColor="#B9C3DA"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Downloads -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/download_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oryn_nav_download"
                android:contentDescription="@string/oryn_download"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:stateListAnimator="@animator/oryn_motion_bounce" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Downloads"
                android:textColor="#B9C3DA"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/install_jar_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oryn_nav_settings"
                android:contentDescription="Settings"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:stateListAnimator="@animator/oryn_motion_bounce" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#B9C3DA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ TOP BAR ============ -->
    <LinearLayout
        android:id="@+id/oryn_top_bar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/oryn_plus_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORYNLAUNCHER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="0.02" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="PLUS"
                android:textColor="#6C7BFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Instance selector (real mcVersionSpinner overlays the pill) -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/oryn_account_pill">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">
                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/oryn_status_dot" />
                <TextView
                    android:id="@+id/oryn_selected_instance_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Minecraft"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/oryn_ic_chevron_down"
                    android:contentDescription="Select instance" />
            </LinearLayout>
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:tag="oryn_plus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.02"
                android:background="@android:color/transparent"
                android:contentDescription="Select Minecraft instance" />
        </FrameLayout>

        <!-- Premium edition badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:background="@drawable/oryn_account_pill">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/oryn_ic_crown"
                android:contentDescription="Premium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Premium Edition"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Utility icons -->
        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/oryn_nav_gamepad"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:background="@drawable/oryn_account_pill"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/oryn_files_nav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/oryn_nav_folder"
            android:contentDescription="Files"
            android:background="@drawable/oryn_account_pill"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/oryn_crash_nav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/oryn_nav_crash"
            android:contentDescription="Crash viewer"
            android:background="@drawable/oryn_account_pill"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/share_logs_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_px_sharelog"
            android:contentDescription="Share logs"
            android:background="@drawable/oryn_account_pill"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
        <ImageButton
            android:id="@+id/social_media_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_discord"
            android:contentDescription="Discord"
            android:background="@drawable/oryn_account_pill"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/oryn_motion_bounce" />
    </LinearLayout>

    <!-- ============ HERO CARD ============ -->
    <FrameLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/oryn_home_bg"
        android:clipToOutline="true"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toBottomOf="@id/oryn_top_bar"
        app:layout_constraintBottom_toTopOf="@id/oryn_news_about_row">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/orynlauncher_snow_hero"
            android:scaleType="centerCrop"
            android:contentDescription="OrynLauncher Plus artwork" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/oryn_hero_scrim" />

        <LinearLayout
            android:id="@+id/oryn_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Thumbnail + Launch -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/oryn_custom_player_image"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/oryn_preview_frame"
                    android:clipToOutline="true">
                    <ImageView
                        android:id="@+id/oryn_minecraft_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/oryn_minecraft_preview"
                        android:scaleType="centerCrop"
                        android:contentDescription="Minecraft landscape preview" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/play_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="▶  LAUNCH"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="2"
                        android:gravity="center"
                        android:background="@drawable/oryn_launch_button"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@animator/oryn_motion_bounce"
                        android:elevation="3dp" />
                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/oryn_nav_settings"
                        android:contentDescription="Launch options"
                        android:background="@drawable/oryn_account_pill"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:stateListAnimator="@animator/oryn_motion_bounce" />
                </LinearLayout>
            </LinearLayout>

            <!-- Welcome text + version info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WELCOME TO"
                    android:textColor="#C9D2E8"
                    android:textSize="10sp"
                    android:letterSpacing="0.2" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OrynLauncher "
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plus"
                        android:textColor="#7C86FF"
                        android:textStyle="bold"
                        android:
                    
