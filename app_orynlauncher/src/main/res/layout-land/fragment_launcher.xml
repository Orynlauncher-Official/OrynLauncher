<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050D19"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/oryn_sidebar"
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:background="@drawable/oryn_sidebar"
        android:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton android:id="@+id/oryn_home" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_home" android:contentDescription="Home" android:background="@drawable/oryn_nav_selected" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/download_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_cube" android:contentDescription="@string/oryn_download" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/custom_control_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_gamepad" android:contentDescription="@string/mcl_option_customcontrol" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/cosmetics_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_cosmetics" android:contentDescription="Cosmetics" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/oryn_files_nav" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_px_file" android:contentDescription="Files" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/oryn_crash_nav" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_crash" android:contentDescription="Crash viewer" android:background="@android:color/transparent" android:padding="8dp" android:layout_marginBottom="5dp"/>
        <ImageButton android:id="@+id/install_jar_button" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/oryn_nav_settings" android:contentDescription="Settings" android:background="@android:color/transparent" android:padding="8dp"/>
    </LinearLayout>

    <!-- Compact top navigation, replacing the old title-only strip. -->
    <LinearLayout
        android:id="@+id/oryn_top_bar"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="#E80A1729"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView android:layout_width="26dp" android:layout_height="30dp" android:layout_marginEnd="2dp" android:src="@drawable/oryn_v4_crystal" android:contentDescription="OrynLauncher logo" android:scaleType="fitCenter"/>
        <TextView
            android:layout_width="148dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="ORYNLAUNCHER PLUS"
            android:textColor="#EAF6FF"
            android:textStyle="bold"
            android:textSize="12sp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="⌂ Home" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" android:background="@android:color/transparent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="◇ Versions" android:textColor="#E4F1FC" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="▱ Modpacks" android:textColor="#E4F1FC" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="⚙ Settings" android:textColor="#E4F1FC" android:textSize="10sp"/>
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/social_media_button" android:layout_width="28dp" android:layout_height="30dp" android:layout_marginStart="3dp" android:src="@drawable/ic_discord" android:contentDescription="Discord" android:background="@android:color/transparent" android:padding="6dp"/>
        <ImageButton android:id="@+id/share_logs_button" android:layout_width="28dp" android:layout_height="30dp" android:src="@drawable/oryn_external" android:contentDescription="Share logs" android:background="@android:color/transparent" android:padding="6dp"/>
        <ImageButton android:id="@+id/oryn_youtube_button" android:layout_width="28dp" android:layout_height="30dp" android:layout_marginStart="2dp" android:src="@drawable/ic_youtube" android:contentDescription="YouTube" android:background="@android:color/transparent" android:padding="5dp"/>
        <ImageButton android:id="@+id/oryn_website_button" android:layout_width="28dp" android:layout_height="30dp" android:layout_marginStart="2dp" android:src="@drawable/ic_globe" android:contentDescription="Website" android:background="@android:color/transparent" android:padding="5dp"/>
    </LinearLayout>

    <!-- Cinematic hero occupies the main canvas instead of the old boxed preview. -->
    <FrameLayout
        android:id="@+id/oryn_launch_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="6dp"
        android:background="#071426"
        android:clipToOutline="true"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintTop_toBottomOf="@id/oryn_top_bar"
        app:layout_constraintBottom_toTopOf="@id/oryn_play_row">
        <ImageView
            android:id="@+id/oryn_minecraft_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/orynlauncher_snow_hero"
            android:scaleType="centerCrop"
            android:contentDescription="OrynLauncher Plus snowy Minecraft hero"/>
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#4A06101F"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp"
            android:background="#7A06101F">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLAY YOUR" android:letterSpacing="0.24" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OWN STORY" android:letterSpacing="0.22" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="24sp"/>
            <TextView android:id="@+id/oryn_selected_instance_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Minecraft" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/oryn_account_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/oryn_selected_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="1.20.4" android:textColor="#FFFFFF" android:textSize="11sp"/>
            <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:tag="oryn_plus" android:layout_width="24dp" android:layout_height="match_parent" android:alpha="0.02" android:background="@android:color/transparent" android:contentDescription="Select Minecraft version"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="◆  Fabric  ▾" android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>
        
    </FrameLayout>

    <!-- Real saved instances and quick actions stay connected to the existing launcher logic. -->
    <LinearLayout
        android:id="@+id/oryn_feature_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/oryn_home_bg"
        app:layout_constraintWidth_percent="0.255"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oryn_top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Your worlds" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/open_files_button" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_add" android:contentDescription="Add or manage instances" android:background="@drawable/oryn_pill" android:padding="6dp"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp" android:fillViewport="false" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR WORLDS" android:textColor="#DDF4FF" android:textSize="9sp" android:textStyle="bold"/>
                <LinearLayout android:id="@+id/oryn_instance_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="GAME VERSION" android:textColor="#DDF4FF" android:textSize="9sp" android:textStyle="bold"/>
                <TextView android:id="@+id/oryn_instance_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/oryn_account_pill" android:text="Select a game version" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="QUICK ACCESS" android:textColor="#DDF4FF" android:textSize="9sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/oryn_account_pill" android:text="Library  •  Files  •  Settings" android:textColor="#FFFFFF" android:textSize="10sp"/>
                
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/oryn_account_pill" android:text="Manage profiles and jump back into your world." android:textColor="#FFFFFF" android:textSize="10sp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Launch strip and library/installation cards. -->
    <LinearLayout
        android:id="@+id/oryn_play_row"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/oryn_home_bg"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintBottom_toTopOf="@id/oryn_news_about_row">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="👤" android:textSize="23sp" android:textColor="#EAF6FF" android:background="@drawable/oryn_account_pill"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="#D8EAF8" android:textSize="9sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spunky Optimized Winter" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <ImageButton android:id="@+id/edit_profile_button" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/oryn_nav_settings" android:contentDescription="Edit profile" android:background="@drawable/oryn_account_pill" android:padding="8dp"/>
        </LinearLayout>
        <Button android:id="@+id/play_button" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1.25" android:layout_marginStart="7dp" android:layout_marginEnd="8dp" android:text="▶  PLAY\n1.20.4  •  Fabric" android:textAllCaps="false" android:textSize="18sp" android:lineSpacingExtra="1dp" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/oryn_launch_button" android:elevation="8dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.65" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Ready" android:textColor="#F0FAFF" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Everything is set!" android:textColor="#D8EAF8" android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/oryn_news_about_row"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:orientation="horizontal"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toEndOf="@id/oryn_sidebar"
        app:layout_constraintEnd_toStartOf="@id/oryn_feature_panel"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:id="@+id/oryn_news_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/oryn_home_bg">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp" android:padding="10dp" android:src="@drawable/oryn_nav_cube" android:background="@drawable/oryn_account_pill" android:contentDescription="Resource library"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RESOURCE LIBRARY" android:textColor="#EAF6FF" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Mods, Resource Packs, Shaders" android:textColor="#D8EAF8" android:textSize="10sp"/>
            </LinearLayout>
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="28sp" android:background="@drawable/oryn_account_pill"/>
            <ImageButton android:id="@+id/crash_viewer_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Crash viewer"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/oryn_about_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/oryn_home_bg">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp" android:padding="10dp" android:src="@drawable/oryn_nav_cube" android:background="@drawable/oryn_account_pill" android:contentDescription="Installation manager"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INSTALLATION MANAGER" android:textColor="#EAF6FF" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Manage versions, installations and modpacks" android:textColor="#D8EAF8" android:textSize="10sp"/>
            </LinearLayout>
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="28sp" android:background="@drawable/oryn_account_pill"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>